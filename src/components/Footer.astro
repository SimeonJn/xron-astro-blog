---
const today = new Date();
---

<footer>
	<div class="line-divider"></div>
	<div class="footer-content animate-up" style="animation-delay: 0.2s;">
		<p>&copy; {today.getFullYear()} Simeon. All rights reserved. | <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer" style="text-decoration: none; color: inherit;">粤ICP备19127754号-1</a></p>
		<div class="social-links">
			<a href="https://github.com/VueHsu/" target="_blank">GitHub</a>
			<span>·</span>
			<a href="https://space.bilibili.com/95668927" target="_blank">Bilibili</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: transparent;
		color: var(--text-muted);
		text-align: center;
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		font-size: 0.9em;
	}
	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
		margin-top: 2em;
	}
	p {
		margin: 0;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		align-items: center;
	}
	.social-links a {
		text-decoration: none;
		color: var(--text-muted);
		border-bottom: 1px dashed transparent;
		transition: all 0.3s ease;
	}
	.social-links a:hover {
		color: var(--text-main);
		border-bottom: 1px dashed var(--text-main);
	}
</style>
