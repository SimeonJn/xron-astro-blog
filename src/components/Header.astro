---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header transition:persist>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/gallery">画廊</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<button type="button" id="theme-toggle" aria-label="Toggle Dark Mode" class="theme-toggle">
				<svg class="theme-icon" viewBox="0 0 24 24" width="20" height="20">
					<mask id="moon-mask">
						<rect x="0" y="0" width="100%" height="100%" fill="white" />
						<circle class="moon-hole" cx="24" cy="0" r="12" fill="black" />
					</mask>
					<circle class="sun-core" cx="12" cy="12" r="5" mask="url(#moon-mask)" fill="currentColor" />
					<g class="sun-rays" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<line x1="12" y1="2" x2="12" y2="5" />
						<line x1="12" y1="19" x2="12" y2="22" />
						<line x1="4.93" y1="4.93" x2="7.05" y2="7.05" />
						<line x1="16.95" y1="16.95" x2="19.07" y2="19.07" />
						<line x1="2" y1="12" x2="5" y2="12" />
						<line x1="19" y1="12" x2="22" y2="12" />
						<line x1="4.93" y1="19.07" x2="7.05" y2="16.95" />
						<line x1="16.95" y1="7.05" x2="19.07" y2="4.93" />
					</g>
				</svg>
			</button>
		</div>
	</nav>
	<div class="line-divider"></div>
</header>
<style>
	.theme-toggle {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		color: var(--text-main);
		font-size: 1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 50%;
		padding: 4px;
		transition: color 0.3s ease, transform 0.3s ease;
	}
	.theme-toggle:hover {
		color: var(--text-muted);
		transform: scale(1.1);
	}

	/* SVG Animations for Dot & Line Minimalist Theme */
	.theme-icon {
		transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
	}
	.sun-core {
		transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), cx 0.6s cubic-bezier(0.25, 1, 0.5, 1), cy 0.6s cubic-bezier(0.25, 1, 0.5, 1), r 0.6s cubic-bezier(0.25, 1, 0.5, 1);
		transform-origin: center;
	}
	.moon-hole {
		transition: cx 0.6s cubic-bezier(0.25, 1, 0.5, 1), cy 0.6s cubic-bezier(0.25, 1, 0.5, 1), r 0.6s cubic-bezier(0.25, 1, 0.5, 1);
	}
	.sun-rays {
		transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease;
		transform-origin: center;
	}

	/* Dark mode styles triggered by HTML class */
	:global(.dark) .theme-icon {
		transform: rotate(-30deg);
	}
	:global(.dark) .sun-core {
		r: 9;
		cx: 12;
		cy: 12;
	}
	:global(.dark) .moon-hole {
		cx: 17;
		cy: 7;
		r: 9;
	}
	:global(.dark) .sun-rays {
		transform: rotate(-180deg) scale(0);
		opacity: 0;
	}
</style>

<script>
	// Theme toggle logic
	const handleToggleClick = (event) => {
		if (event) {
			event.preventDefault();
		}
		
		const element = document.documentElement;
		const isDark = !element.classList.contains("dark");

		if (!document.startViewTransition || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			element.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
			return;
		}

		element.classList.add("theme-transition");

		const transition = document.startViewTransition(() => {
			element.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		});

		transition.ready.then(() => {
			const x = event?.clientX ?? innerWidth / 2;
			const y = event?.clientY ?? innerHeight / 2;
			const endRadius = Math.hypot(
				Math.max(x, innerWidth - x),
				Math.max(y, innerHeight - y)
			);

			const isClick = event && event.clientX !== undefined;
			
			const animation = document.documentElement.animate(
				{
					clipPath: [
						`circle(0px at ${x}px ${y}px)`,
						`circle(${endRadius}px at ${x}px ${y}px)`
					],
				},
				{
					duration: 500,
					easing: "ease-in-out",
					pseudoElement: "::view-transition-new(root)",
				}
			);
		});

		transition.finished.finally(() => {
			element.classList.remove("theme-transition");
		});
	};

	// 在开启 transition:persist 后，需要手动更新 header 的激活状态
	document.addEventListener('astro:page-load', () => {
		const pathname = window.location.pathname;
		const links = document.querySelectorAll('.internal-links a');
		
		links.forEach((link) => {
			const href = link.getAttribute('href');
			if (!href) return;
			
			// 精确匹配首页，或部分匹配其他路径（如 /blog/post-1 -> /blog）
			if (href === '/') {
				link.classList.toggle('active', pathname === '/');
			} else {
				link.classList.toggle('active', pathname.startsWith(href));
			}
		});
		const themeToggle = document.getElementById("theme-toggle");
		if (themeToggle) {
			// Remove any previous event listeners to avoid duplicates on client routing
			themeToggle.removeEventListener("click", handleToggleClick);
			themeToggle.addEventListener("click", handleToggleClick);
		}
	});
</script>

<style>
	header {
		margin: 0 auto;
		padding: 2em 1em 0em;
		background: transparent;
		width: 720px;
		max-width: calc(100% - 2em);
	}

	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}

	h2 a {
		text-decoration: none;
		color: var(--text-main);
		border-bottom: none;
	}

	h2 a:hover {
		border-bottom: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.internal-links {
		display: flex;
		gap: 1.5em;
	}

	.internal-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9em;
		border-bottom: 1px dashed transparent;
		padding-bottom: 2px;
		transition: all 0.3s ease;
	}

	.internal-links a:hover,
	.internal-links a.active {
		color: var(--text-main);
		border-bottom: 1px dotted var(--text-main);
	}

	.line-divider {
		margin: 2em 0 0 0;
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			gap: 1em;
		}
	}
</style>
