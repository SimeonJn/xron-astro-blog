---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header transition:persist>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/gallery">画廊</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
	<div class="line-divider"></div>
</header>

<script>
	// 在开启 transition:persist 后，需要手动更新 header 的激活状态
	document.addEventListener('astro:page-load', () => {
		const pathname = window.location.pathname;
		const links = document.querySelectorAll('.internal-links a');
		
		links.forEach((link) => {
			const href = link.getAttribute('href');
			if (!href) return;
			
			// 精确匹配首页，或部分匹配其他路径（如 /blog/post-1 -> /blog）
			if (href === '/') {
				link.classList.toggle('active', pathname === '/');
			} else {
				link.classList.toggle('active', pathname.startsWith(href));
			}
		});
	});
</script>

<style>
	header {
		margin: 0 auto;
		padding: 2em 1em 0em;
		background: transparent;
		width: 720px;
		max-width: calc(100% - 2em);
	}

	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}

	h2 a {
		text-decoration: none;
		color: var(--text-main);
		border-bottom: none;
	}

	h2 a:hover {
		border-bottom: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.internal-links {
		display: flex;
		gap: 1.5em;
	}

	.internal-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9em;
		border-bottom: 1px dashed transparent;
		padding-bottom: 2px;
		transition: all 0.3s ease;
	}

	.internal-links a:hover,
	.internal-links a.active {
		color: var(--text-main);
		border-bottom: 1px dotted var(--text-main);
	}

	.line-divider {
		margin: 2em 0 0 0;
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			gap: 1em;
		}
	}
</style>
