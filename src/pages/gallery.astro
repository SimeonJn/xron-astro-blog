---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Load processed photo data from JSON
import galleryImages from '../data/gallery.json';

const formattedImages = galleryImages.map((img) => {
    return {
        ...img,
        // Optional: construct full res link if you ever upload originals to COS
        fullResSrc: img.src // Or map to COS URL
    };
});

function getClockIcon(dateString) {
    if (!dateString) return '🕛';
    
    // 如果字符串包含时间信息 (如包含 ":")，则尝试解析
    let hours = 0; // 默认12点
    if (dateString.includes(':') || dateString.includes('T')) {
        const date = new Date(dateString);
        if (!isNaN(date.getTime())) {
            hours = date.getHours() % 12;
        }
    } else {
        // 如果只有日期，为了增加趣味性，可以用日期的字符串哈希给一个固定的表盘
        // 或者简单默认返回 🕛。这里用简单的哈希让它看起来有变化
        let hash = 0;
        for (let i = 0; i < dateString.length; i++) {
            hash = dateString.charCodeAt(i) + ((hash << 5) - hash);
        }
        hours = Math.abs(hash) % 12;
    }

    const clockIcons = ['🕛', '🕐', '🕑', '🕒', '🕓', '🕔', '🕕', '🕖', '🕗', '🕘', '🕙', '🕚'];
    return clockIcons[hours];
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Gallery | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			/* Override global main style for full width */
			main {
				width: 100% !important;
				max-width: 100% !important;
				margin: 0 !important;
				padding: 4em 0 !important;
				overflow-x: hidden;
				min-height: 100vh;
			}

			.gallery-header {
				text-align: center;
				margin-bottom: 5em;
				padding: 0 2em;
				position: relative;
				z-index: 10;
			}

			.gallery-heading {
				font-size: 3.5em;
				display: inline-block;
				border-bottom: 2px dashed var(--line-color-dark);
				padding-bottom: 0.2em;
				margin-bottom: 0.5em;
				letter-spacing: 2px;
				font-weight: 700;
			}

			.gallery-desc {
				color: var(--text-muted);
				font-size: 1.1em;
				letter-spacing: 1px;
			}

			/* Scattered Grid Layout */
			.gallery-container {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 4em 3em;
				padding: 2em 4em 8em;
				max-width: 1600px;
				margin: 0 auto;
			}

			/* Polaroid Container */
			.polaroid-item {
				position: relative;
				width: 310px;
				min-height: 380px; /* Use min-height so it can stretch if content is tall */
				/* Scattering rotations */
				transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), z-index 0s;
				cursor: pointer;
				z-index: 5;
			}

			/* Pseudo-random rotations for "scattered" look */
			.polaroid-item:nth-child(5n+1) { transform: rotate(-4deg) translateY(10px); }
			.polaroid-item:nth-child(5n+2) { transform: rotate(3deg) translateY(-10px); }
			.polaroid-item:nth-child(5n+3) { transform: rotate(-2deg) translateY(20px); }
			.polaroid-item:nth-child(5n+4) { transform: rotate(5deg) translateY(-5px); }
			.polaroid-item:nth-child(5n+5) { transform: rotate(-5deg) translateY(5px); }

			/* Hover effect */
			.polaroid-item:hover, .polaroid-item:focus-within {
				transform: scale(1.1) rotate(0deg) !important;
				z-index: 100;
			}

			/* Loading Dotted Frame */
			.dashed-frame {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				border: 2px dashed var(--line-color-dark);
				background: transparent;
				z-index: 1;
				transition: opacity 0.6s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--line-color-dark);
				font-size: 0.9em;
				letter-spacing: 3px;
				opacity: 1;
			}

			.dashed-frame::after {
				content: "LOADING";
				animation: blink 1.5s infinite ease-in-out;
			}

			@keyframes blink {
				0%, 100% { opacity: 0.3; }
				50% { opacity: 1; }
			}

			/* Default Hidden Frame (Polaroid Content) */
			.polaroid-content {
				position: relative;
				z-index: 2;
				background: #ffffff;
				padding: 15px 15px 60px 15px;
				box-shadow: 0 10px 25px rgba(0,0,0,0.08);
				border: 1px solid var(--line-color);
				opacity: 0;
				transform: scale(0.95);
				transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
				height: 100%;
				display: flex;
				flex-direction: column;
				pointer-events: none; /* Ignore pointer until loaded */
				box-sizing: border-box;
			}

			/* Loaded State */
			.polaroid-item.loaded .dashed-frame {
				opacity: 0;
				pointer-events: none;
			}

			.polaroid-item.loaded .polaroid-content {
				opacity: 1;
				transform: scale(1);
				pointer-events: auto;
			}

			.polaroid-item.loaded:hover .polaroid-content {
				box-shadow: 0 20px 40px rgba(0,0,0,0.15);
			}

			/* Image Details */
			.polaroid-content img {
				width: 100%;
				height: 250px; /* Force image height */
				object-fit: cover; /* Don't crop, show full photo like real polaroid */
				background: #f4f4f4; /* Subtle background for transparency or contain empty space */
				border: 1px solid #ebebeb;
				/* Start with faded look, transition to full color */
				filter: grayscale(100%) opacity(0);
				transition: filter 1.2s ease, opacity 1s ease, transform 0.6s ease;
				display: block;
			}

			.polaroid-item.loaded img {
				filter: grayscale(0%) contrast(1.05); /* Full color when loaded */
				opacity: 1;
			}

			.polaroid-item.loaded:hover img {
				transform: scale(1.02);
			}

			/* The image wrapper to hide overflow of scaled image */
			.polaroid-img-wrapper {
				overflow: hidden;
				width: 100%;
				height: 250px;
			}

			.polaroid-caption {
				margin-top: auto;
				text-align: center;
				font-size: 0.95em;
				color: #444;
				font-family: inherit;
				letter-spacing: 1px;
				border-top: 1px dashed var(--line-color);
				padding-top: 1em;
				word-break: break-all;
			}

			/* Mobile adjust */
			@media (max-width: 720px) {
				.gallery-container {
					gap: 2em;
					padding: 1em 2em;
				}
				.polaroid-item {
					width: 100%;
					max-width: 320px;
					height: auto;
					/* Reduce scatter angle on mobile to prevent overflow clipping badly */
					transform: rotate(0) !important; 
					margin-bottom: 2em;
				}
				.polaroid-content {
					padding-bottom: 50px;
				}
				.polaroid-item:nth-child(odd) { transform: rotate(1.5deg) !important; }
				.polaroid-item:nth-child(even) { transform: rotate(-1.5deg) !important; }
			}

			/* --- 灯箱 (Lightbox) 样式 --- */
			.lightbox {
				position: fixed;
				top: 0; left: 0; right: 0; bottom: 0;
				background: rgba(0, 0, 0, 0.85);
				z-index: 1000;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.4s ease;
				backdrop-filter: blur(5px);
			}

			.lightbox.open {
				opacity: 1;
				pointer-events: auto;
			}

			.lightbox-close {
				position: absolute;
				top: 20px;
				right: 30px;
				color: white;
				font-size: 40px;
				cursor: pointer;
				z-index: 1001;
				font-family: sans-serif;
				transition: transform 0.3s;
			}

			.lightbox-close:hover {
				transform: scale(1.2);
			}

			.lightbox-loader {
				position: absolute;
				color: #fff;
				font-size: 1.2em;
				letter-spacing: 2px;
				animation: blink 1.5s infinite;
			}

			.lightbox-content {
				position: relative;
				max-width: 90vw;
				max-height: 90vh;
				/* 给高清原图也套一层干净的白底拍立得质感 */
				background: #fff;
				padding: 20px 20px 60px 20px; /* 底部留白写描述 */
				box-shadow: 0 20px 50px rgba(0,0,0,0.5);
				border-radius: 4px;
				opacity: 0;
				transform: scale(0.9) translateY(20px);
				transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
			}

			.lightbox-content.img-loaded {
				opacity: 1;
				transform: scale(1) translateY(0);
			}

			.lightbox-content img {
				display: block;
				max-width: 100%;
				max-height: calc(90vh - 100px); /* 减去 paading 空间 */
				object-fit: contain;
			}

			.lightbox-caption {
				position: absolute;
				bottom: 20px;
				left: 0;
				right: 0;
				text-align: center;
				color: #333;
				font-size: 1.2em;
				letter-spacing: 1px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- 弹出的灯箱 -->
			<div id="gallery-lightbox" class="lightbox">
				<div class="lightbox-close" id="lightbox-close">&times;</div>
				<div class="lightbox-loader" id="lightbox-loader">LOADING HD...</div>
				<div class="lightbox-content" id="lightbox-content">
					<img id="lightbox-img" src="" alt="High Resolution Photo" />
					<div class="lightbox-caption" id="lightbox-caption"></div>
				</div>
			</div>

			<div class="gallery-container">
				{formattedImages.map((image) => (
					<!-- 在这里绑定 data-full-src 用于后续 JS 截取原图链接 -->
					<div class="polaroid-item scroll-animate" data-full-src={image.fullResSrc} data-alt={image.alt}>
						<!-- Loading Placeholder -->
						<div class="dashed-frame"></div>
						
						<!-- Polaroid Card -->
						<div class="polaroid-content">
							<div class="polaroid-img-wrapper">
								<img 
									src={image.src} 
									alt={image.alt} 
									loading="lazy" 
									onload="this.closest('.polaroid-item').classList.add('loaded')" 
								/>
							</div>
							<div class="polaroid-caption">
								{image.alt && <div class="caption-title">{image.alt}</div>}
								{image.description && <div class="caption-desc" style="font-size: 0.85em; color: #888; margin-top: 0.3em; line-height: 1.2;">{image.description}</div>}
								{(image.date || image.location) && (
									<div class="caption-meta" style="font-size: 0.75em; color: #aaa; margin-top: 0.8em; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; border-top: 1px solid #f0f0f0; padding-top: 6px;">
										{image.date && <span class="date">{getClockIcon(image.date)} {image.date}</span>}
										{image.location && <span class="location">📍 {image.location}</span>}
									</div>
								)}
							</div>
						</div>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<!-- Fallback JS in case image loads from cache before onload event attaches -->
		<script>
			const initGallery = () => {
				const images = document.querySelectorAll('.polaroid-content img');
				images.forEach(img => {
					// @ts-ignore
					if (img.complete) {
						img.closest('.polaroid-item')?.classList.add('loaded');
					}
				});

				// 灯箱逻辑
				const polaroids = document.querySelectorAll('.polaroid-item');
				const lightbox = document.getElementById('gallery-lightbox');
				const lightboxImg = document.getElementById('lightbox-img');
				const lightboxCaption = document.getElementById('lightbox-caption');
				const lightboxContent = document.getElementById('lightbox-content');
				const btnClose = document.getElementById('lightbox-close');

				polaroids.forEach(p => {
					p.addEventListener('click', () => {
						const fullSrc = p.getAttribute('data-full-src');
						const altText = p.getAttribute('data-alt');
						
						if (!lightbox || !lightboxImg || !lightboxContent) return;

						// 重置状态
						lightboxContent.classList.remove('img-loaded');
						// @ts-ignore
						lightboxImg.src = '';
						
						// 开启灯箱（这时候背景变暗，只显示 LOADING 文字）
						lightbox.classList.add('open');
						
						// 预加载原图
						const tempImg = new Image();
						tempImg.onload = () => {
							// @ts-ignore
							lightboxImg.src = fullSrc;
							// @ts-ignore
							lightboxImg.alt = altText;
							// @ts-ignore
							if (lightboxCaption) lightboxCaption.textContent = altText;
							// 图片加载好后弹出拍立得相框
							lightboxContent.classList.add('img-loaded');
						};
						// @ts-ignore
						tempImg.src = fullSrc; 
					});
				});

				// 关闭事件
				const closeLightbox = () => {
					lightbox?.classList.remove('open');
					// 等待隐藏动画结束后清空 src (大约 400ms)
					setTimeout(() => {
						if (lightboxContent) lightboxContent.classList.remove('img-loaded');
						// @ts-ignore
						if (lightboxImg) lightboxImg.src = '';
					}, 400);
				};

				btnClose?.addEventListener('click', closeLightbox);
				// 点击背景也可以关闭
				lightbox?.addEventListener('click', (e) => {
					if (e.target === lightbox) {
						closeLightbox();
					}
				});
				// ESC 键关闭
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && lightbox?.classList.contains('open')) {
						closeLightbox();
					}
				});
			};

			document.addEventListener('DOMContentLoaded', initGallery);
			document.addEventListener('astro:page-load', initGallery);
			
			if (document.readyState === 'complete' || document.readyState === 'interactive') {
				initGallery();
			}
		</script>
	</body>
</html>
