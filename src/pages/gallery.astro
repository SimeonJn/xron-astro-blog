---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/polaroid.css';

// Load processed photo data from JSON
import galleryImages from '../data/gallery.json';

const publicPhotoModules = import.meta.glob('../../public/photos/*.webp', {
	eager: true,
	import: 'default',
});

const publicPhotoAssetsByName = new Map(
	Object.entries(publicPhotoModules).map(([filePath, asset]) => {
		const fileName = filePath.split('/').pop() ?? '';
		return [fileName, asset];
	})
);

const formattedImages = galleryImages.map((img) => {
	const fileName = img.src.split('/').pop() ?? '';
    return {
        ...img,
        // Optional: construct full res link if you ever upload originals to COS
		fullResSrc: img.src, // Or map to COS URL
		thumbnailAsset: publicPhotoAssetsByName.get(fileName),
    };
});

const fallbackLightboxAsset = formattedImages.find((image) => image.thumbnailAsset)?.thumbnailAsset;

function getClockIcon(dateString) {
    if (!dateString) return '🕛';
    
    // 如果字符串包含时间信息 (如包含 ":")，则尝试解析
    let hours = 0; // 默认12点
    if (dateString.includes(':') || dateString.includes('T')) {
        const date = new Date(dateString);
        if (!isNaN(date.getTime())) {
            hours = date.getHours() % 12;
        }
    } else {
        // 如果只有日期，为了增加趣味性，可以用日期的字符串哈希给一个固定的表盘
        // 或者简单默认返回 🕛。这里用简单的哈希让它看起来有变化
        let hash = 0;
        for (let i = 0; i < dateString.length; i++) {
            hash = dateString.charCodeAt(i) + ((hash << 5) - hash);
        }
        hours = Math.abs(hash) % 12;
    }

    const clockIcons = ['🕛', '🕐', '🕑', '🕒', '🕓', '🕔', '🕕', '🕖', '🕗', '🕘', '🕙', '🕚'];
    return clockIcons[hours];
}

function formatDateDisplay(dateString) {
    if (!dateString) return '';
    return String(dateString).split(' ')[0].replace(/-/g, '/');
}
---

<!doctype html>
<html lang="zh-hans">
	<head>
		<BaseHead title={`Gallery | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			/* Override global main style for full width */
			main {
				width: 100% !important;
				max-width: 100% !important;
				margin: 0 !important;
				padding: 4em 0 !important;
				overflow-x: hidden;
				min-height: 100vh;
			}

			/* Scattered Grid Layout */
			.gallery-container {
				/* 定义缩放相关的 CSS 变量 */
				--zoom: 1;
				--polaroid-width-base: 310px;
				--polaroid-height-base: 380px;
				--polaroid-img-height-base: 250px;
				
				--polaroid-width: calc(var(--polaroid-width-base) * var(--zoom));
				--polaroid-height: calc(var(--polaroid-height-base) * var(--zoom));

				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: calc(4em * var(--zoom)) calc(3em * var(--zoom));
				padding: 2em 4em 8em;
				max-width: 1600px;
				margin: 0 auto;
			}

			/* 覆盖 polaroid.css 以支持缩放 */
			.gallery-container .polaroid-item {
				width: var(--polaroid-width) !important;
				height: var(--polaroid-height) !important;
			}

			.gallery-container .polaroid-content {
				font-size: calc(1rem * var(--zoom));
				padding: calc(15px * var(--zoom)) calc(15px * var(--zoom)) calc(25px * var(--zoom)) calc(15px * var(--zoom)) !important;
			}

			.gallery-container .polaroid-img-wrapper,
			.gallery-container .polaroid-content img {
				height: calc(var(--polaroid-img-height-base) * var(--zoom)) !important;
			}

			/* Zoom Controls */
			.zoom-controls-wrapper {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 15px;
				margin: -2em auto 2em;
				position: relative;
				z-index: 10;
				color: var(--text-muted);
				font-size: 0.9em;
				letter-spacing: 1px;
			}

			.zoom-slider {
				-webkit-appearance: none;
				width: 150px;
				height: 2px;
				background: var(--line-color-dark, #ccc);
				outline: none;
				border-radius: 2px;
				transition: opacity 0.2s;
			}

			.zoom-slider::-webkit-slider-thumb {
				-webkit-appearance: none;
				appearance: none;
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: #555;
				cursor: pointer;
				border: 2px solid #fff;
				box-shadow: 0 0 2px rgba(0,0,0,0.4);
				transition: transform 0.2s ease;
			}
			
			.zoom-slider::-webkit-slider-thumb:hover {
				transform: scale(1.3);
			}

			/* Polaroid Container */

			/* Pseudo-random rotations for "scattered" look */
			.polaroid-item:nth-child(5n+1) { transform: rotate(-4deg) translateY(10px); }
			.polaroid-item:nth-child(5n+2) { transform: rotate(3deg) translateY(-10px); }
			.polaroid-item:nth-child(5n+3) { transform: rotate(-2deg) translateY(20px); }
			.polaroid-item:nth-child(5n+4) { transform: rotate(5deg) translateY(-5px); }
			.polaroid-item:nth-child(5n+5) { transform: rotate(-5deg) translateY(5px); }

			/* Hover effect */
			.polaroid-item:hover, .polaroid-item:focus-within {
				transform: scale(1.1) rotate(0deg) !important;
				z-index: 100;
			}

			/* Loading Dotted Frame */
			.dashed-frame {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				border: 2px dashed var(--line-color-dark);
				background: transparent;
				z-index: 1;
				transition: opacity 0.6s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--line-color-dark);
				font-size: 0.9em;
				letter-spacing: 3px;
				opacity: 1;
			}

			.dashed-frame::after {
				content: "LOADING";
				animation: blink 1.5s infinite ease-in-out;
			}

			@keyframes blink {
				0%, 100% { opacity: 0.3; }
				50% { opacity: 1; }
			}

			/* Loaded State */
			.polaroid-item.loaded .dashed-frame {
				opacity: 0;
				pointer-events: none;
			}

			/* Mobile adjust */
			@media (max-width: 720px) {
				.gallery-container {
					gap: calc(2em * var(--zoom));
					padding: 1em 2em;
					--polaroid-width-base: 320px;
				}
				
				.zoom-controls-wrapper {
					margin: -3em auto 2em;
					width: 100%;
					padding: 0 2em;
					box-sizing: border-box;
				}
				
				.zoom-slider {
					width: 100%;
					max-width: 250px;
				}

				.gallery-container .polaroid-item {
					width: 100% !important;
					max-width: var(--polaroid-width) !important;
					height: var(--polaroid-height) !important;
					/* Reduce scatter angle on mobile to prevent overflow clipping badly */
					transform: rotate(0) !important; 
					margin-bottom: calc(2em * var(--zoom));
				}
				.gallery-container .polaroid-content {
					padding-bottom: calc(25px * var(--zoom)) !important;
				}
				.gallery-container .polaroid-item:nth-child(odd) { transform: rotate(1.5deg) !important; }
				.gallery-container .polaroid-item:nth-child(even) { transform: rotate(-1.5deg) !important; }
			}

			/* --- 灯箱 (Lightbox) 样式 --- */
			.lightbox {
				position: fixed;
				top: 0; left: 0; right: 0; bottom: 0;
				background: rgba(0, 0, 0, 0.85);
				z-index: 1000;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.4s ease;
				backdrop-filter: blur(5px);
			}

			.lightbox.open {
				opacity: 1;
				pointer-events: auto;
			}

			.lightbox-close {
				position: absolute;
				top: 20px;
				right: 30px;
				color: white;
				font-size: 40px;
				cursor: pointer;
				z-index: 1001;
				font-family: sans-serif;
				transition: transform 0.3s;
			}

			.lightbox-close:hover {
				transform: scale(1.2);
			}

			.lightbox-loader {
				position: absolute;
				color: #fff;
				font-size: 1.2em;
				letter-spacing: 2px;
				animation: blink 1.5s infinite;
			}

			.lightbox-content {
				position: relative;
				max-width: 90vw;
				max-height: 90vh;
				/* 给高清原图也套一层干净的白底拍立得质感 */
				background: #fff;
				padding: 15px; /* 内部给点留白 */
				box-shadow: 0 20px 50px rgba(0,0,0,0.5);
				border: 1px solid var(--line-color, #ebebeb);
				opacity: 0;
				transform: scale(0.9) translateY(20px);
				transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
				display: flex;
				flex-direction: column;
				align-items: center;
			}

			.lightbox-content.img-loaded {
				opacity: 1;
				transform: scale(1) translateY(0);
			}

			.lightbox-content img {
				display: block;
				max-width: 100%;
				max-height: calc(85vh - 120px); /* 留足下面文字的高度 */
				object-fit: contain;
				border: 1px solid #f4f4f4;
			}

			.lightbox-info {
				width: 100%;
				margin-top: 15px;
				padding-top: 15px;
				border-top: 1px dashed #ccc;
				display: flex;
				flex-direction: column;
				align-items: center;
				color: #333;
				text-align: center;
			}
			
			.lightbox-info .title {
				font-size: 1.25em;
				font-weight: 500;
				letter-spacing: 2px;
				opacity: 0;
				transform: translateY(10px);
				transition: opacity 0.3s ease 0.1s, transform 0.3s ease 0.1s;
			}
			
			.lightbox-info .desc {
				font-size: 0.9em;
				color: #666;
				margin-top: 6px;
				letter-spacing: 1px;
				opacity: 0;
				transform: translateY(10px);
				transition: opacity 0.3s ease 0.2s, transform 0.3s ease 0.2s;
			}

			.lightbox-info .meta {
				font-size: 0.8em;
				color: #999;
				margin-top: 8px;
				display: flex;
				align-items: center;
				gap: 10px;
				letter-spacing: 1.5px;
				opacity: 0;
				transform: translateY(10px);
				transition: opacity 0.3s ease 0.3s, transform 0.3s ease 0.3s;
			}
			
			.lightbox-info .meta .dot {
				width: 4px;
				height: 4px;
				background-color: #ccc;
				border-radius: 50%;
			}

			.lightbox-content.img-loaded .lightbox-info .title,
			.lightbox-content.img-loaded .lightbox-info .desc,
			.lightbox-content.img-loaded .lightbox-info .meta {
				opacity: 1;
				transform: translateY(0);
			}

			/* 切换状态，保持尺寸但有微反响 */
			.lightbox-content.img-loaded.switching {
				opacity: 0.6;
				transform: scale(0.98);
				transition: opacity 0.2s ease, transform 0.2s ease;
			}

			.lightbox-nav {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				color: white;
				font-size: 3em;
				cursor: pointer;
				z-index: 1001;
				user-select: none;
				padding: 20px;
				transition: transform 0.3s, opacity 0.3s;
				opacity: 0.7;
				font-family: monospace;
			}

			.lightbox-nav:hover {
				transform: translateY(-50%) scale(1.2);
				opacity: 1;
			}

			.lightbox-nav.prev {
				left: 20px;
			}

			.lightbox-nav.next {
				right: 20px;
			}

			@media (max-width: 720px) {
				.lightbox-nav {
					font-size: 2em;
					padding: 10px;
				}
				.lightbox-nav.prev { left: 5px; }
				.lightbox-nav.next { right: 5px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- 缩放控制滑块 -->
			<div class="zoom-controls-wrapper">
				<span>-</span>
				<input type="range" class="zoom-slider" id="zoomSlider" min="0.4" max="1.5" step="0.01" value="1" aria-label="Zoom images" />
				<span>+</span>
			</div>

			<!-- 弹出的灯箱 -->
			<div id="gallery-lightbox" class="lightbox">
				<div class="lightbox-close" id="lightbox-close">&times;</div>
				<div class="lightbox-nav prev" id="lightbox-prev">&lt;</div>
				<div class="lightbox-nav next" id="lightbox-next">&gt;</div>
				<div class="lightbox-loader" id="lightbox-loader">LOADING HD...</div>
				<div class="lightbox-content" id="lightbox-content">
					{fallbackLightboxAsset ? (
						<Image id="lightbox-img" src={fallbackLightboxAsset} alt="High Resolution Photo" />
					) : (
						<img id="lightbox-img" src="" alt="High Resolution Photo" />
					)}
					<div class="lightbox-info">
						<div class="title" id="lightbox-title"></div>
						<div class="desc" id="lightbox-desc"></div>
						<div class="meta" id="lightbox-meta">
							<span id="lightbox-date"></span>
							<div class="dot" id="lightbox-meta-dot"></div>
							<span id="lightbox-location"></span>
						</div>
					</div>
				</div>
			</div>

			<div class="gallery-container">
				{formattedImages.map((image) => (
					<!-- 在这里绑定 data-full-src 用于后续 JS 截取原图链接 -->
					<div class="polaroid-item scroll-animate" 
                        data-full-src={image.fullResSrc} 
                        data-alt={image.alt || ''}
                        data-desc={image.description || ''}
                        data-date={image.date ? `${getClockIcon(image.date)} ${formatDateDisplay(image.date)}` : ''}
                        data-location={image.location || ''}
                    >
						<!-- Loading Placeholder -->
						<div class="dashed-frame"></div>
						
						<!-- Polaroid Card -->
						<div class="polaroid-content">
							<div class="polaroid-img-wrapper">
								{image.thumbnailAsset ? (
									<Image 
										src={image.thumbnailAsset} 
										alt={image.alt || ''} 
										loading="lazy" 
										onload="this.closest('.polaroid-item').classList.add('loaded')" 
									/>
								) : (
									<img 
										src={image.src} 
										alt={image.alt} 
										loading="lazy" 
										onload="this.closest('.polaroid-item').classList.add('loaded')" 
									/>
								)}
							</div>
							<div class="polaroid-caption">
								<div class="caption-row title">{image.alt || ''}</div>
								<div class="caption-row desc" title={image.description || ''}>{image.description || ''}</div>
								<div class="caption-row meta">
									{image.date ? <span class="date">{`${getClockIcon(image.date)} ${formatDateDisplay(image.date)}`}</span> : <span></span>}
									{image.location ? <span class="location">📍 {image.location}</span> : <span></span>}
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<!-- Fallback JS in case image loads from cache before onload event attaches -->
		<script>
			const initGallery = () => {
				const images = document.querySelectorAll('.polaroid-content img');
				images.forEach(img => {
					// @ts-ignore
					if (img.complete) {
						img.closest('.polaroid-item')?.classList.add('loaded');
					}
				});

				// 灯箱逻辑
				const polaroids = document.querySelectorAll('.polaroid-item');
				const lightbox = document.getElementById('gallery-lightbox');
				const lightboxImg = document.getElementById('lightbox-img');
				const lightboxTitle = document.getElementById('lightbox-title');
				const lightboxDesc = document.getElementById('lightbox-desc');
				const lightboxDate = document.getElementById('lightbox-date');
				const lightboxLocation = document.getElementById('lightbox-location');
				const lightboxMetaDot = document.getElementById('lightbox-meta-dot');
				const lightboxContent = document.getElementById('lightbox-content');
				const btnClose = document.getElementById('lightbox-close');
				const btnPrev = document.getElementById('lightbox-prev');
				const btnNext = document.getElementById('lightbox-next');

				let currentIndex = -1;
				const imagesData = Array.from(polaroids).map((p, idx) => {
					// 绑定索引以便点击时知道当前是哪一张
					p.setAttribute('data-index', idx.toString());
					return {
						fullSrc: p.getAttribute('data-full-src'),
						alt: p.getAttribute('data-alt'),
						desc: p.getAttribute('data-desc'),
						date: p.getAttribute('data-date'),
						location: p.getAttribute('data-location')
					};
				});

				let currentLoadToken = null;

				const openLightboxImage = (index) => {
					if (index < 0 || index >= imagesData.length) return;
					if (!lightbox || !lightboxImg || !lightboxContent) return;

					currentIndex = index;
					const data = imagesData[index];
					const isOpen = lightbox.classList.contains('open');

					// 防止连续点击导致加载乱序
					const token = Symbol();
					currentLoadToken = token;
					lightboxImg.removeAttribute('srcset');
					lightboxImg.removeAttribute('sizes');

					if (!isOpen) {
						// 第一次打开，重置状态并收起动画
						lightboxContent.classList.remove('img-loaded', 'switching');
						// @ts-ignore
						lightboxImg.src = '';
						// 显示背景及 LOADING
						lightbox.classList.add('open');
					} else {
						// 已在灯箱中切换，保留容器尺寸只做微调动画
						lightboxContent.classList.add('switching');
					}
					
					const applyImage = () => {
						if (currentLoadToken !== token) return;

						// @ts-ignore
						lightboxImg.src = data.fullSrc || '';
						// @ts-ignore
						lightboxImg.alt = data.alt || '';
						
						// 填充信息
						if (lightboxTitle) lightboxTitle.textContent = data.alt || '';
						if (lightboxDesc) {
							lightboxDesc.textContent = data.desc || '';
							lightboxDesc.style.display = data.desc ? 'block' : 'none';
						}
						if (lightboxDate) {
							lightboxDate.textContent = data.date || '';
							lightboxDate.style.display = data.date ? 'inline' : 'none';
						}
						if (lightboxLocation) {
							lightboxLocation.textContent = data.location ? `📍 ${data.location}` : '';
							lightboxLocation.style.display = data.location ? 'inline' : 'none';
						}
						if (lightboxMetaDot) {
							lightboxMetaDot.style.display = (data.date && data.location) ? 'block' : 'none';
						}

						// 图片加载好后弹出或者恢复拍立得相框状态
						lightboxContent.classList.add('img-loaded');
						lightboxContent.classList.remove('switching');
					};

					// 预加载原图
					if (data.fullSrc) {
						const tempImg = new Image();
						tempImg.onload = applyImage;
						tempImg.onerror = applyImage; // 防止图片损坏或缺失时一直卡 Loading
						// @ts-ignore
						tempImg.src = data.fullSrc; 
					} else {
						applyImage();
					}
				};

				polaroids.forEach(p => {
					p.addEventListener('click', () => {
						const index = parseInt(p.getAttribute('data-index') || '0', 10);
						openLightboxImage(index);
					});
				});

				const nextImage = (e) => {
					if (e) e.stopPropagation();
					openLightboxImage((currentIndex + 1) % imagesData.length);
				};

				const prevImage = (e) => {
					if (e) e.stopPropagation();
					openLightboxImage((currentIndex - 1 + imagesData.length) % imagesData.length);
				};

				btnNext?.addEventListener('click', nextImage);
				btnPrev?.addEventListener('click', prevImage);

				// 关闭事件
				const closeLightbox = () => {
					lightbox?.classList.remove('open');
					// 等待隐藏动画结束后清空 src (大约 400ms)
					setTimeout(() => {
						if (lightboxContent) lightboxContent.classList.remove('img-loaded');
						// @ts-ignore
						if (lightboxImg) lightboxImg.src = '';
					}, 400);
				};

				btnClose?.addEventListener('click', (e) => {
					if (e) e.stopPropagation();
					closeLightbox();
				});
				
				// 点击背景也可以关闭
				lightbox?.addEventListener('click', (e) => {
					// 只有当点击目标确实是 lightbox 本身时才关闭，而不是内部元素
					if (e.target === lightbox) {
						closeLightbox();
					}
				});
				
				// 键盘事件
				// @ts-ignore
				document.removeEventListener('keydown', window.galleryKeydownHandler);
				// @ts-ignore
				window.galleryKeydownHandler = (e) => {
					if (!lightbox?.classList.contains('open')) return;
					
					if (e.key === 'Escape') {
						closeLightbox();
					} else if (e.key === 'ArrowRight') {
						nextImage();
					} else if (e.key === 'ArrowLeft') {
						prevImage();
					}
				};
				// @ts-ignore
				document.addEventListener('keydown', window.galleryKeydownHandler);


				// ===================
				// 无极缩放 (Zoom) 逻辑
				// ===================
				const zoomSlider = document.getElementById('zoomSlider');
				const galleryContainer = document.querySelector('.gallery-container');
				
				if (zoomSlider && galleryContainer) {
					// @ts-ignore
					zoomSlider.addEventListener('input', (e) => {
						// @ts-ignore
						const zoomValue = e.target.value;
						// @ts-ignore
						galleryContainer.style.setProperty('--zoom', zoomValue);
					});
					// 初始化恢复默认数值
					// @ts-ignore
					galleryContainer.style.setProperty('--zoom', zoomSlider.value);
				}
			};

			document.addEventListener('DOMContentLoaded', initGallery);
			document.addEventListener('astro:page-load', initGallery);
			
			if (document.readyState === 'complete' || document.readyState === 'interactive') {
				initGallery();
			}
		</script>
	</body>
</html>
