---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagsSet = new Set<string>();
posts.forEach(post => {
	post.data.tags?.forEach(tag => tagsSet.add(tag));
});
const tags = Array.from(tagsSet).sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.archive-header {
				display: flex;
				flex-direction: column;
				gap: 1em;
				margin-bottom: 2.5em;
			}
			.archive-heading {
				font-size: 2.5em;
				margin-bottom: 0;
				border-bottom: 2px solid var(--text-main);
				padding-bottom: 0.5em;
				display: inline-block;
				width: max-content;
			}
			.tags-filter {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8em;
				align-items: center;
			}
			.tag-filter-item {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.9em;
				padding: 0.2rem 0;
				border-bottom: 1px dotted transparent;
				transition: color 0.3s ease, border-color 0.3s ease;
			}
			.tag-filter-item:hover, .tag-filter-item.active {
				color: var(--text-main);
				border-bottom-color: var(--text-main);
			}
			
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			
			ul li {
				margin-bottom: 0;
				border-bottom: 1px dashed var(--line-color-dark);
			}
			
			ul li a {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5em 0;
				text-decoration: none;
				border-bottom: none;
				color: var(--text-main);
				position: relative;
				transition: transform 0.3s ease, padding-left 0.3s ease;
			}

			ul li a::before {
				content: '';
				position: absolute;
				left: 0;
				top: 50%;
				transform: translateY(-50%);
				width: 6px;
				height: 6px;
				background-color: var(--text-main);
				border-radius: 50%;
				opacity: 0;
				transition: opacity 0.3s ease;
			}

			ul li a:hover {
				padding-left: 20px;
			}

			ul li a:hover::before {
				opacity: 1;
			}

			.title {
				margin: 0;
				font-size: 1.5em;
				font-weight: 700;
				transition: color 0.3s ease;
			}
			
			.title-and-tags {
				display: flex;
				flex-direction: column;
				gap: 0.3em;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
			}
			.post-tag-item {
				color: var(--text-muted);
				font-size: 0.8em;
				letter-spacing: 0.05em;
			}
			
			.date {
				margin: 0;
				color: var(--text-muted);
				font-size: 0.9em;
				white-space: nowrap;
				min-width: 120px;
				text-align: right;
			}
			
			@media (max-width: 720px) {
				ul li a {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.5em;
				}
				.date {
					text-align: left;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="archive-header animate-up">
					{tags.length > 0 && (
						<div class="tags-filter">
							<a href="/blog" class="tag-filter-item active" data-tag="all">All</a>
							{tags.map((tag) => (
								<a href={`?tag=${tag}`} class="tag-filter-item" data-tag={tag}>#{tag}</a>
							))}
						</div>
					)}
				</div>
				<ul id="blog-list">
					{
						posts.map((post, index) => (
							<li class="scroll-animate post-item" data-tags={post.data.tags ? post.data.tags.join(',') : ''} style={`transition-delay: ${0.1 + ((index % 5) * 0.05)}s`}>
								<a href={`/blog/${post.id}/`}>
									<div class="title-and-tags">
										<div class="title">{post.data.title}</div>
										{post.data.tags && post.data.tags.length > 0 && (
											<div class="post-tags">
												{post.data.tags.map((tag) => (
													<span class="post-tag-item">#{tag}</span>
												))}
											</div>
										)}
									</div>
									<div class="date">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const params = new URLSearchParams(window.location.search);
				const selectedTag = params.get('tag');
				const items = document.querySelectorAll('.post-item');
				const filterLinks = document.querySelectorAll('.tag-filter-item');

				function filterPosts(tag) {
					filterLinks.forEach(link => {
						if (link.getAttribute('data-tag') === tag || (tag === null && link.getAttribute('data-tag') === 'all')) {
							link.classList.add('active');
						} else {
							link.classList.remove('active');
						}
					});

					items.forEach(item => {
						const tags = item.getAttribute('data-tags') || '';
						if (!tag || tag === 'all') {
							item.style.display = '';
						} else {
							const tagsArray = tags.split(',');
							if (tagsArray.includes(tag)) {
								item.style.display = '';
							} else {
								item.style.display = 'none';
							}
						}
					});
				}

				filterPosts(selectedTag);
				
				// Optional: Client-side navigation without reload
				filterLinks.forEach(link => {
					link.addEventListener('click', (e) => {
						e.preventDefault();
						const tag = link.getAttribute('data-tag');
						const newUrl = tag === 'all' ? '/blog' : `/blog?tag=${tag}`;
						window.history.pushState({path: newUrl}, '', newUrl);
						filterPosts(tag);
					});
				});
				
				window.addEventListener('popstate', () => {
					const params = new URLSearchParams(window.location.search);
					filterPosts(params.get('tag'));
				});
			});
		</script>
	</body>
</html>
