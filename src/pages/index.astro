---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);
---

<!doctype html>
<html lang="zh-hans">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 4em 0;
				position: relative;
			}
			.hero-title {
				font-size: 3em;
				margin-bottom: 0.5em;
				position: relative;
				display: inline-block;
			}
			.hero-title::after {
				content: '';
				position: absolute;
				bottom: -10px;
				left: 0;
				width: 50px;
				height: 2px;
				background-color: var(--text-main);
				transition: width 0.5s ease;
			}
			.hero:hover .hero-title::after {
				width: 100%;
			}
			.hero-subtitle {
				color: var(--text-muted);
				font-size: 1.2em;
				max-width: 600px;
			}
			
			.section-heading {
				font-size: 1.5em;
				margin-top: 2em;
				margin-bottom: 1em;
				display: flex;
				align-items: center;
				gap: 1em;
			}
			.section-heading::after {
				content: '';
				flex-grow: 1;
				height: 1px;
				background: repeating-linear-gradient(to right, var(--line-color-dark) 0, var(--line-color-dark) 2px, transparent 2px, transparent 6px);
			}

			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				padding: 1.5em 0;
				border-bottom: 1px solid var(--line-color);
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1.5em;
				position: relative;
				transition: transform 0.3s ease;
			}
			.post-item:hover {
				transform: translateX(10px);
			}
			.post-item::before {
				content: '';
				position: absolute;
				left: -15px;
				top: 50%;
				transform: translateY(-50%);
				width: 4px;
				height: 4px;
				background-color: var(--text-main);
				border-radius: 50%;
				opacity: 0;
				transition: opacity 0.3s ease;
			}
			.post-item:hover::before {
				opacity: 1;
			}
			@media (max-width: 720px) {
				.post-item {
					flex-direction: column;
					gap: 0.5em;
				}
			}
			.post-title {
				font-size: 1.25em;
				font-weight: 700;
				margin: 0;
			}
			.post-title a {
				border-bottom: none;
			}
			.post-date {
				color: var(--text-muted);
				font-size: 0.9em;
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero animate-up" style="animation-delay: 0.1s;">
				<h1 class="hero-title">Hey, I'm Simeon.</h1>
				<p class="hero-subtitle">
					欢迎来到我的极简空间。我在这里记录技术、Web 开发与设计的内容。在代码之外，我也在画廊中分享我的照片。<br/><br/>
					Welcome to my minimal space. I write about technology, web development, and design. Between lines of code, I share my visual captures in the gallery.
				</p>
			</section>

			<section class="animate-up" style="animation-delay: 0.2s;">
				<h2 class="section-heading">最近更新</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-item">
								<h3 class="post-title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								<div class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</div>
							</li>
						))
					}
				</ul>
				<div style="margin-top: 2em;">
					<a href="/blog" style="font-weight: bold; border-bottom: 1px dotted var(--text-main);">View all posts &rarr;</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
